# Copy to .env and fill in. Never commit .env. See docs/build/sdd.md §8.

# TypeSafe Jev API key — create at console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Decision backend: jev | llm (auto-falls back to llm on Jev outage/timeout)
DECISION_BACKEND=jev

# NEAR AI Cloud API key (LLM fallback + text output) — cloud.near.ai, see HACKATHON.md Q-000
NEAR_AI_API_KEY=

# NEAR network: testnet by default; mainnet only with human confirmation
NEAR_NETWORK=testnet

# Dev account the app signs with
NEAR_ACCOUNT_ID=

# Private key for NEAR_ACCOUNT_ID — dev account only; never commit
NEAR_PRIVATE_KEY=

# RPC endpoint — pick from https://docs.near.org/api/rpc/providers
NEAR_RPC_URL=

# Optional NEAR Intents 1Click JWT (HACKATHON.md Q-006); without it a 0.2% fee applies
NEAR_INTENTS_JWT=
