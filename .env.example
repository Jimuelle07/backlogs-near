# Copy to .env and fill in. Never commit .env. See docs/build/sdd.md §8.

# TypeSafe Jev API key — create at console.typesafe.ai/keys (required for the checker's main Jev path and firewall-jev-ping)
TYPESAFE_API_KEY=

# Where the checker calls Jev: typesafe (default, main path: api.typesafe.ai, uses TYPESAFE_API_KEY) or nearai (routes Jev through NEAR AI Cloud /v1/systemone, uses NEAR_AI_API_KEY)
JEV_PROVIDER=typesafe
# Optional Jev model override (default jev-latest on typesafe, typesafe/jev-1.13 on nearai)
JEV_MODEL=

# NEAR AI Cloud (OpenAI-compatible) — cloud.near.ai, see HACKATHON.md Q-000
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# NEAR AI Cloud model id with tool calling (list via GET $NEAR_AI_BASE_URL/models); used by --llm near-ai
AGENT_MODEL=

# Which backend the checker's DecisionClient uses: jev (default, NEAR AI Cloud LLM as fallback) or llm
DECISION_BACKEND=jev

# NEAR AI Cloud model for the checker's LLM decision fallback
CHECKER_LLM_MODEL=

# NEAR network: testnet by default; mainnet only with human confirmation
NEAR_NETWORK=testnet

# RPC endpoint. The legacy near.org testnet RPC is deprecated and rate-limited (-429); use FastNEAR.
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Owner account + key (testnet only; used by firewall-setup-testnet — human-gated). Never commit.
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=

# Written to .env.testnet by firewall-setup-testnet
GUARDIAN_ID=
# Written by firewall-setup-testnet; needed to redeploy the Guardian. Never commit.
GUARDIAN_PRIVATE_KEY=
TOKEN_ID=
# Agent key must be a function-call key (receiver = guardian, method request_payment)
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
CHECKER_ACCOUNT_ID=
CHECKER_PRIVATE_KEY=

# Native checker binary (default: target/release/checker[.exe]) and decision-record dir
CHECKER_BIN=
CHECKER_RECORD_DIR=data/decisions
