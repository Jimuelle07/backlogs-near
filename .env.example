# Copy to .env and fill in. Never commit .env. See docs/build/sdd.md §8.

# TypeSafe Jev API key — create at console.typesafe.ai/keys (required for the checker's main Jev path and firewall-jev-ping)
TYPESAFE_API_KEY=

# Where the checker calls Jev: typesafe (default, main path: api.typesafe.ai, uses TYPESAFE_API_KEY) or nearai (routes Jev through NEAR AI Cloud /v1/systemone, uses NEAR_AI_API_KEY)
JEV_PROVIDER=typesafe
# Optional Jev model override (default jev-latest on typesafe, typesafe/jev-1.13 on nearai)
JEV_MODEL=

# NEAR AI Cloud (OpenAI-compatible) — cloud.near.ai, see HACKATHON.md Q-000
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# NEAR AI Cloud model id with tool calling (list via GET $NEAR_AI_BASE_URL/models); used by --llm near-ai
AGENT_MODEL=

# Which backend the checker's DecisionClient uses: jev (default, NEAR AI Cloud LLM as fallback) or llm
DECISION_BACKEND=jev

# NEAR AI Cloud model for the checker's LLM decision fallback
CHECKER_LLM_MODEL=

# Checker policy rules (checker/src/policy.rs). All optional; for OutLayer runs set them as OutLayer secrets.
# POLICY_ENABLED=0 turns the check off (signals.policy = null). Allowlist: comma-separated receiver ids. Max amount: token base units.
POLICY_ENABLED=1
POLICY_ALLOWLIST=
POLICY_MAX_AMOUNT=
POLICY_MAX_MEMO_CHARS=128

# Checker fusion thresholds (checker/src/fusion.rs). All optional; empty = default. For OutLayer runs set them
# as OutLayer secrets. Thresholds are probabilities in [0, 1]. FUSION_HOLD_THRESHOLD defaults to 0.84 (q̂ calibrated
# 2026-11-12 on 150 benign cases, ε = 5%, C5); the other probability thresholds default to 0.5, uncalibrated;
# FUSION_YOUNG_ACCOUNT_DAYS is a non-negative number of days (default 7). A malformed value fails the run (exit 2).
FUSION_HOLD_THRESHOLD=
FUSION_INJECTION_THRESHOLD=
FUSION_JEV_INJECTION_THRESHOLD=
FUSION_JEV_RECEIVER_RISK_THRESHOLD=
# FUSION_AGENT_HOLD_THRESHOLD: probability in [0, 1]; optional. Replaces FUSION_HOLD_THRESHOLD only when the agent
# profile has payments_last_90d >= 99.
FUSION_AGENT_HOLD_THRESHOLD=
# JEV_REFERENCE_EXAMPLES_JSON: optional, opt-in, never set by default. A JSON object with exactly the keys
# fraud_examples and legitimate_examples, each an array of 1-10 strings of at most 600 characters; added to the Jev
# state as reference_cases. Its content in our eval comes from CC BY-SA data and is never committed.
JEV_REFERENCE_EXAMPLES_JSON=
FUSION_YOUNG_ACCOUNT_DAYS=
# FUSION_MODE: jev (default) or code_rules (never calls Jev; evaluation baselines only). CASCADE_ENABLED: 1/0
# (default 0); with FUSION_MODE=jev the classifier runs only when Jev `unusual` > FUSION_HOLD_THRESHOLD.
FUSION_MODE=
CASCADE_ENABLED=
# NOTE: FUSION_MODE=code_rules is for evaluation only; never set it as an OutLayer secret.

# Checker counterparty signals (checker/src/counterparty.rs). All optional. Read from the environment the
# check is on (COUNTERPARTY_ENABLED=0 turns it off: signals.counterparty = null). The checker does not read
# NEAR_RPC_URL: RPC view_account runs only when COUNTERPARTY_RPC_URL is set. Profile precedence:
# AGENT_PROFILE_JSON > AGENT_PROFILE_PATH > COUNTERPARTY_KNOWN_PAYEES (comma list) > built-in default payees.
# COUNTERPARTY_TIMEOUT_MS maximum is 2000 (30 s OutLayer budget); larger is a config error. COUNTERPARTY_NAMESPACE
# (account suffix, e.g. jimuelle-firewall.testnet) adds <base>.<ns> to the built-in default payees only.
# OutLayer secrets must include COUNTERPARTY_NAMESPACE=jimuelle-firewall.testnet: only the agent's run_checker sets it,
# so without it the OutLayer run treats hostco.jimuelle-firewall.testnet as a lookalike of bare hostco and holds benign payments.
# COUNTERPARTY_ENABLED=1
# COUNTERPARTY_RPC_URL=
# COUNTERPARTY_TIMEOUT_MS=2000
# COUNTERPARTY_NAMESPACE=
# COUNTERPARTY_MAX_LOOKALIKE_DISTANCE=2
# COUNTERPARTY_KNOWN_PAYEES=
# AGENT_PROFILE_JSON=
# AGENT_PROFILE_PATH=

# Off-chain DecisionRecord sink URL (checker/src/sink.rs). Optional locally; set as an OutLayer secret so
# OutLayer checker runs POST each DecisionRecord JSON here. If set and the POST fails, allow turns into hold.
DECISION_LOG_URL=

# Hosted injection classifier (checker/src/injection.rs; protectai/deberta-v3-base-prompt-injection-v2).
# Unset CLASSIFIER_URL or INJECTION_ENABLED=0 turns the check off (signals.injection = null).
CLASSIFIER_URL=
INJECTION_ENABLED=1
HF_TOKEN=

# NEAR network: testnet by default; mainnet only with human confirmation
NEAR_NETWORK=testnet

# RPC endpoint. The legacy near.org testnet RPC is deprecated and rate-limited (-429); use FastNEAR.
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Owner account + key (testnet only; used by firewall-setup-testnet — human-gated). Never commit.
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=

# Written to .env.testnet by firewall-setup-testnet
GUARDIAN_ID=
# Written by firewall-setup-testnet; needed to redeploy the Guardian. Never commit.
GUARDIAN_PRIVATE_KEY=
TOKEN_ID=
# Agent key must be a function-call key (receiver = guardian, method request_payment)
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# Optional plain-agent account with a full-access key for demo step 3 (--unprotected / --mode unprotected);
# written by firewall-setup-testnet and falls back to OWNER_ACCOUNT_ID / OWNER_PRIVATE_KEY when unset.
UNPROTECTED_AGENT_ACCOUNT_ID=
UNPROTECTED_AGENT_PRIVATE_KEY=
CHECKER_ACCOUNT_ID=
CHECKER_PRIVATE_KEY=

# Native checker binary (default: target/release/checker[.exe]) and decision-record dir
CHECKER_BIN=
CHECKER_RECORD_DIR=data/decisions
