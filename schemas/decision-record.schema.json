{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/backlogs-near/schemas/decision-record.schema.json",
  "title": "DecisionRecord",
  "description": "Full off-chain decision record, kept in the owner's log. Never written on-chain or returned to the agent (it holds probabilities). record_sha256 in the verdict is the sha256 of the exact serialized record bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "input_sha256", "request_id", "checker_version", "outcome", "reasons", "signals"],
  "properties": {
    "format": {"const": "firewall.decision_record.v1"},
    "input_sha256": {"$ref": "verdict.schema.json#/$defs/Sha256", "description": "sha256 of the exact checker stdin bytes."},
    "request_id": {"$ref": "checker-input.schema.json#/$defs/U64"},
    "checker_version": {"$ref": "verdict.schema.json#/$defs/Semver"},
    "outcome": {"$ref": "verdict.schema.json#/$defs/Outcome"},
    "reasons": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "verdict.schema.json#/$defs/ReasonCode"}},
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "injection", "melon", "counterparty", "jev"],
      "description": "Each signal is null when its check is disabled or not yet implemented.",
      "properties": {
        "policy": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Policy"}]},
        "injection": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Injection"}]},
        "melon": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Melon"}]},
        "counterparty": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Counterparty"}]},
        "jev": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Jev"}]}
      }
    }
  },
  "$defs": {
    "Probability": {"type": "number", "minimum": 0, "maximum": 1},
    "Policy": {
      "type": "object", "additionalProperties": false, "required": ["ok", "violations"],
      "properties": {"ok": {"type": "boolean"}, "violations": {"type": "array", "items": {"type": "string"}}}
    },
    "Injection": {
      "type": "object", "additionalProperties": false, "required": ["max_score", "per_item", "model", "model_sha256"],
      "properties": {
        "max_score": {"$ref": "#/$defs/Probability"},
        "per_item": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["ref", "score"],
          "properties": {"ref": {"type": "string"}, "score": {"$ref": "#/$defs/Probability"}}
        }},
        "model": {"type": "string"},
        "model_sha256": {"type": "string"}
      }
    },
    "Melon": {
      "type": "object", "additionalProperties": false, "required": ["masked_call_matches", "llm_model"],
      "properties": {"masked_call_matches": {"type": "boolean"}, "llm_model": {"type": "string"}}
    },
    "Counterparty": {
      "type": "object", "additionalProperties": false,
      "required": ["account_age_days", "is_contract", "code_changed_recently", "prior_payments", "lookalike_of", "lookalike_distance"],
      "properties": {
        "account_age_days": {"type": ["number", "null"]},
        "is_contract": {"type": "boolean"},
        "code_changed_recently": {"type": "boolean"},
        "prior_payments": {"type": "integer", "minimum": 0},
        "lookalike_of": {"type": ["string", "null"]},
        "lookalike_distance": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "Jev": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "model", "unusual", "injection_driven", "receiver_risk", "label", "label_probabilities"],
      "properties": {
        "backend": {"enum": ["jev", "llm"]},
        "model": {"type": "string"},
        "unusual": {"$ref": "#/$defs/Probability"},
        "injection_driven": {"$ref": "#/$defs/Probability"},
        "receiver_risk": {"$ref": "#/$defs/Probability"},
        "label": {"enum": ["A", "B", "C"]},
        "label_probabilities": {
          "type": "object", "additionalProperties": false, "required": ["A", "B", "C"],
          "properties": {"A": {"$ref": "#/$defs/Probability"}, "B": {"$ref": "#/$defs/Probability"}, "C": {"$ref": "#/$defs/Probability"}}
        }
      }
    }
  }
}
