{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/backlogs-near/schemas/results.schema.json",
  "title": "EvalResults",
  "description": "Benchmark evaluation results across firewall defense configurations. Produced by the eval harness (A3, C4) and rendered on the landing page (E3, D4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "generated_at",
    "checker_version",
    "dataset",
    "conformal",
    "caveats",
    "rows"
  ],
  "properties": {
    "format": {
      "const": "firewall.results.v1"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of the evaluation run."
    },
    "checker_version": {
      "$ref": "verdict.schema.json#/$defs/Semver"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_scenarios",
        "benign_count",
        "attack_count",
        "families"
      ],
      "properties": {
        "total_scenarios": {
          "type": "integer",
          "minimum": 1
        },
        "benign_count": {
          "type": "integer",
          "minimum": 0
        },
        "attack_count": {
          "type": "integer",
          "minimum": 0
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conformal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epsilon",
        "q_hat_hold",
        "calibration_size",
        "test_size"
      ],
      "properties": {
        "epsilon": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "q_hat_hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calibration_size": {
          "type": "integer",
          "minimum": 1
        },
        "test_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ResultRow"
      }
    }
  },
  "$defs": {
    "ResultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "false_holds_pct",
        "false_blocks_pct",
        "missed_attacks_pct",
        "median_latency_ms",
        "cost_per_payment_usd"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "false_holds_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "false_blocks_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "missed_attacks_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "median_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "cost_per_payment_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
